# Required before go-live
DOMAIN=example.org
APP_BASE_URL=https://example.org
SENTRY_DSN=
POSTGRES_PASSWORD=change-this-postgres-password
JWT_SECRET=change-this-in-production-use-a-64-char-random-string-generated-with-openssl
ADMIN_EMAIL=bootstrap-admin@example.org
ADMIN_PASSWORD=change-this-bootstrap-admin-password
ADMIN_NAME=Bootstrap Admin
CONTRIBUTOR_KEY_SALT=change-this-contributor-salt
CONFIRM_IP_SALT=change-this-confirm-ip-salt
STRICT_INTEGRATIONS=true
PORT=3001
DATABASE_URL=postgresql://crisis_user:change-this-postgres-password@localhost:5432/crisis_db

# Mail and account recovery
MAIL_FROM=noreply@example.org
RESEND_API_KEY=
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
ALLOW_INSECURE_PASSWORD_RESET_LOG=false

# Submission and abuse controls
RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=10
ABUSE_MAX_REPORTS_PER_HOUR=8
ABUSE_MAX_REPORTS_PER_DAY=25
ABUSE_REPEAT_WINDOW_MINUTES=30
MAX_UPLOAD_SIZE=8388608
MAX_PHOTOS=5

# Media storage
MEDIA_BACKEND=local
MEDIA_PUBLIC_BASE_URL=
MEDIA_SIGNED_URL_TTL_SECONDS=900
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional AI and translation settings
AI_API_KEY=
AI_ALLOW_INSECURE_TLS=false
AI_MODEL_VISION=google/gemma-4-26b-a4b-it:free
AI_MODEL_TEXT=openai/gpt-oss-120b:free
AI_CLASSIFY_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AI_SITREP_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-nano-12b-v2-vl:free
AI_CLASSIFY_MAX_PER_MINUTE=20
AI_CLASSIFY_MAX_PER_DAY=1000
AI_CLASSIFY_POLL_MS=15000

TRANSLATION_ENABLED=true
TRANSLATION_API_KEY=
TRANSLATION_API_BASE_URL=
TRANSLATION_MODEL=openai/gpt-oss-120b:free
TRANSLATION_FALLBACK_MODELS=openai/gpt-oss-20b:free,openrouter/free

# Optional frontend overrides
VITE_API_URL=

# WhatsApp is intentionally out of scope for the single-server live deployment path.
WHATSAPP_SERVICE_TOKEN=local-whatsapp-integration-token
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=undp-crisis-webhook-2024
